### Fullscreen windows  ###
   for_window {
  
       [app_id="mpv"] fullscreen enable

   }

### Floating Windows ###

   for_window {

       [app_id="org.telegram.desktop"] floating enable, reszie set 850 550, move poistion center
       [app_id="Waydroid"] floating enable, move position center
       [app_id="ncmpcpp"] floating enable, resize set 850 550, move container to $ws4, move poistion center
       [app_id="yazi"] floating enable, resize set 1200 750, move container to $ws5
       [app_id="imv"] floating enable, resize set 850 550
    }

### Dialogs ###

 set $handle_dialog floating enable, move container to workspace current

   for_window {

       [app_id="chromium" title="Open File"] $handle_dialog
       [app_id="firefoxnightly" title="^Enter name of file to save to…$"] $handle_dialog
       [app_id="firefoxnightly" title="^Open File$"] $handle_dialog
       [app_id="firefoxnightly" title="^Save As$"] $handle_dialog
       [app_id="firefoxnightly" title="^Save Image$"] $handle_dialog
       [app_id="firefoxnightly" title="File Upload"] $handle_dialog
       [app_id="firefoxnightly" title="^Firefox - Choose User Profile$"] $handle_dialog
       [app_id="firefoxnightly" title="^Developer Tools — "] $handle_dialog
       [app_id="firefoxnightly" title="^Opening "] $handle_dialog
       [app_id="firefoxnightly" title="^Extension: \(MetaMask\) - MetaMask Notification — Mozilla Firefox$"] $handle_dialog
       [app_id="Chromium" title="^DevTools - "] $handle_dialog
       [app_id="chromium-bin-browser" title="^Save File$"] $handle_dialog
       [app_id="org.telegram.desktop" title="^Choose Files$"] $handle_dialog
       [app_id="firefox" title="^Choose Application$"] $handle_dialog
       [title="(?:Open|Save) (?:File|Folder|As)"] $handle_dialog
       [app_id="pop-up,task_dialog,About"] $handle_dialog;
       [app_id="zenity"] $handle_dialog
       [window_role="pop-up,task_dialog,About"] $handle_dialog;
       [window_type="dialog"] $handle_dialog;
       [window_type="utility"] $handle_dialog;
       [window_type="toolbar"] $handle_dialog;
       [window_type="splash"] $handle_dialog;
       [window_type="menu"] $handle_dialog;
       [window_type="dropdown_menu"] $handle_dialog;
       [window_type="popup_menu"] $handle_dialog;
       [window_type="tooltip"] $handle_dialog;
       [window_type="notification"] $handle_dialog;

   }

### Assign Apps To Workspaces ###

   assign {

       [app_id="firefoxnightly"] $ws1 
       [app_id="google-chrome"] $ws1
       [app_id="zen-browser"] $ws1
       [app_id="Alacritty"] $ws2
       [app_id="foot"] $ws2
       [app_id="ncmpcpp"] $ws4
       [app_id="yazi"] $ws5
       [app_id="mpv"] $ws8
       [app_id="Waydroid"] $ws9
       [app_id="org.telegram.desktop"] $ws10

   }

### Focus When Launched ###

   for_window {

       [app_id="Alacritty"] focus
       [app_id="foot"] focus
       [app_id="google-chrome"] focus
       [app_id="firefoxnightly"] focus
       [app_id="zen-browser"] focus
       [app_id="mpv"] focus
       [app_id="ncmpcpp"] focus
       [app_id="yazi"] focus
       [app_id="org.telegram.desktop"] focus

   } 

### Scratchpads ###

   for_window {

       [app_id="^scratchpad$"] move scratchpad, move container to workspace current
       [app_id="^scratchpad_input$"] move scratchpad, move container to workspace current

   }

### Workspace Rules ###

   workspace_layout default
   workspace_auto_back_and_forth yes

### Mouse Rules ###

   focus_follows_mouse yes
