window {
  /*background-color: rgba (203, 50, 68, 0.11);*/
  /*background: alpha(#36364f, 0.30);*/
  /*background: alpha(#9d81bf, 0.02);*/
  background: alpha(#1e1e2e, 0.60);
  /*background: alpha(#3B3455, 0.15);*/
  /*opacity: 0.9;*/
	border-radius: 12px;
	border-style: solid;
	border-width: 0.5px;
	border-color: alpha(#cba6f7, 0.7)
}

#box {
  /* Define attributes of the box surrounding icons here */
  padding: 8px
}

button, image {
	background: none;
	border-style: none;
	box-shadow: none;
	color: #999
}

button {
	/*padding-left: 4px;
	padding-right: 4px;*/
	padding: 4px 8px;
	margin-left: 5px;
	margin-right: 5px;
	color: #eee;
        font-size: 12px
}

button:hover {
	background-color: rgba (255, 255, 255, 0.10);
	border-radius: 10px;
        transition: all 0.3s ease-out;
}

button:focus {
	box-shadow: 0 0 2px;
}

tooltip {
        background-color: alpha(#fff, 0.02);
}
